__pycache__/
*.pyc
*.egg-info/
.venv/
.ipynb_checkpoints/
.pytest_cache/

# Large or regenerated files. Rebuild them with the scripts in scripts/.
data/raw/*
data/processed/*
data/indexes/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Small enough to share through git: the scripted test debates and the gzipped training examples.
!data/processed/test_dialogues.jsonl
!data/processed/train_examples.jsonl.gz
!data/processed/val_examples.jsonl.gz
!data/indexes/.gitkeep
outputs/*
!outputs/.gitkeep
checkpoints/
